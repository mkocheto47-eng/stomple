{
  "name": "stomple-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:party": "wrangler dev --port 1999",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:party": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name stomple"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}