# Адрес PartyKit-сервера без протокола.
# Локально: localhost:1999
# После деплоя: stomple.<ваш-ник>.workers.dev
VITE_PARTY_HOST=localhost:1999

# Необязательно: TURN-сервер для голосового чата, если у кого-то из друзей
# не проходит прямое соединение (строгий NAT у оператора).
# Бесплатные: https://www.metered.ca/tools/openrelay/ или Cloudflare Calls TURN.
# VITE_TURN_URL=turn:a.relay.metered.ca:80
# VITE_TURN_USER=...
# VITE_TURN_PASS=...
