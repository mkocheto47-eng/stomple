# Адрес PartyKit-сервера без протокола.
# Локально: localhost:1999
# После деплоя: stomple.<ваш-ник>.workers.dev
VITE_PARTY_HOST=localhost:1999

# TURN-сервер для голосового чата. Без него телефоны на мобильном интернете
# друг друга не находят. По умолчанию используется публичный Metered OpenRelay;
# для надёжности заведите свой бесплатный аккаунт на https://www.metered.ca
# (TURN Server → Create app → Credentials) и пропишите:
# VITE_TURN_URL=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turn:a.relay.metered.ca:443?transport=tcp
# VITE_TURN_USER=...
# VITE_TURN_PASS=...
